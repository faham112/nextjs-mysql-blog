DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_db_name

AUTH_SECRET=replace-with-a-long-random-string-openssl-rand-hex-32
ADMIN_EMAIL=admin@globalcareerhub.org
ADMIN_PASSWORD=change-me

NEXT_PUBLIC_SITE_URL=https://globalcareerhub.org

# Secret for GET /api/cron/publish (scheduled posts). Use a long random string.
CRON_SECRET=replace-with-a-long-random-string

# AdSense publisher ID, digits only (from pub-XXXXXXXXXXXXXXXX). Leave empty until approved;
# /ads.txt serves a placeholder line until this is set.
ADSENSE_PUB_ID=

# Uploaded files in public/uploads are wiped on every Hostinger deploy. Keep 0 so posts use the
# git-hosted /covers images; set to 1 only once uploads are stored persistently.
USE_UPLOAD_IMAGES=0
